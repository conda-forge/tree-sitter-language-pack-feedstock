# Fix upstream e2e test/API TypedDict-vs-attribute-access mismatch (v1.15.12)
#
# tree_sitter_language_pack/options.py defines `ProcessResult` as a
# `TypedDict(total=False)`, and `api.process()` returns that TypedDict --
# i.e. a plain `dict` at runtime. The alef-generated e2e tests in
# e2e/python/tests/{test_process,test_data_extraction,test_error_handling}.py
# were auto-generated using attribute access (`result.language`,
# `result.metrics`, `result.data`, ...) on that return value, which raises
# `AttributeError: 'dict' object has no attribute '<key>'` at test time.
#
# Both the TypedDict producer (options.py/api.py) and the failing test
# consumers are alef-generated code, so this is an upstream code-generation
# defect (the alef test generator and the alef API generator disagree on
# whether ProcessResult is attribute- or subscript-accessed). This patch
# works around the defect on the test side only, changing only the
# top-level access on the object returned by `process(...)` to subscript
# form (`result["language"]`, `result["metrics"]`, `result["data"]`, ...).
# Nested access on the real dataclass objects contained inside
# ProcessResult (StructureItem, ImportInfo, FileMetrics, DataNode, etc.,
# all `@dataclass(frozen=True, slots=True)`) is left untouched, e.g.
# `result["metrics"].total_lines`, `_e.kind`, `item.name`.
#
# This is reported upstream for evidence; conda-forge carries this patch
# only so the e2e test suite can run to completion during `pixi run test`.
#
# Per-file occurrence counts changed (top-level `result.<key>` ->
# `result["<key>"]`):
#   e2e/python/tests/test_process.py         158 occurrences (33 failing tests)
#   e2e/python/tests/test_data_extraction.py  74 occurrences (32 failing tests)
#   e2e/python/tests/test_error_handling.py    1 occurrence  (1 failing test:
#                                               test_error_process_empty_source)
#
# All accessed keys (language, metrics, data) are unconditionally populated
# by `_from_native_process_result()` in options.py, along with the other
# ProcessResult keys (structure, imports, exports, comments, docstrings,
# symbols, diagnostics, chunks) -- none are conditionally omitted at
# runtime, so subscript access is safe and does not require `.get()`
# fallbacks despite `ProcessResult` being declared `total=False`.
#
# Verified against a clean extraction of v1.15.12
# (sha256 e5e17a014a05020790b6a202eff692e85427642f996211e65b2b5a7057769044).
--- a/e2e/python/tests/test_process.py
+++ b/e2e/python/tests/test_process.py
@@ -33,11 +33,11 @@
     config = {"language": "c"}

     result = process(source, config)
-    assert result.language == "c"
-    assert len(result.structure) >= 1
-    assert any("Function" in str(_e.kind) for _e in (result.structure or []))
-    assert result.metrics.total_lines >= 6
-    assert result.metrics.error_count == 0
+    assert result["language"] == "c"
+    assert len(result["structure"]) >= 1
+    assert any("Function" in str(_e.kind) for _e in (result["structure"] or []))
+    assert result["metrics"].total_lines >= 6
+    assert result["metrics"].error_count == 0


