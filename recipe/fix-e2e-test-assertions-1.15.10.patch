# Fix broken assertions in the auto-generated e2e test suite (upstream bug).
#
# e2e/python/tests/test_process.py is generated by the "alef" tool (see the
# "DO NOT EDIT" / "alef:hash:..." header in the file) and contains assertions
# that index one level too deep into result.structure[] / result.imports[]
# entries that are already the element type. This causes 19 spurious test
# failures (across 20 broken assertion lines - two test functions each
# contain two adjacent broken lines, and the first raises AttributeError
# before the second ever executes, so only 19 distinct tests were reported
# failing even though 20 lines needed fixing) against a correctly-behaving
# 1.15.10 package. This patch corrects those assertions as evidence for an
# upstream bug report; it is not a functional change to the package itself.
#
# 1) `_e.structure[0].kind` -> `_e.kind` (20 occurrences, 19 test functions)
#    result.structure is a list of StructureItem (PyO3 #[pyclass], see
#    crates/ts-pack-core-py/src/lib.rs). StructureItem's fields are kind,
#    name, visibility, span, children, decorators, doc_comment, signature,
#    body_span - there is NO `structure` field on StructureItem itself, so
#    `_e.structure[0]` raises AttributeError. The intended check is simply
#    `_e.kind` on each already-iterated element `_e`.
#    kind is a StructureKind #[pyclass(frozen)] wrapper whose __str__
#    serde-serializes to a bare string with variants Function/Method/Class/
#    Struct/Interface/Enum/Module/Trait/Impl/Namespace, so
#    `str(_e.kind) == "Function"` / "Class" / "Module" (the literal words
#    used at each call site are preserved unchanged by this patch) is
#    confirmed correct by source and the corrected assertions genuinely
#    pass, rather than merely stop raising AttributeError.
#
# 2) `_e.imports[0].source` -> `_e.source` (1 occurrence)
#    result.imports is a list of ImportInfo (PyO3 #[pyclass], see
#    crates/ts-pack-core-py/src/lib.rs:740-755):
#        pub struct ImportInfo {
#            #[pyo3(get)]
#            pub source: String,
#            ...
#    ImportInfo has no `imports` field, so `_e.imports[0]` raises
#    AttributeError; the intended check is `_e.source` on each
#    already-iterated element `_e`.
#
# Verified against a clean extraction of v1.15.10
# (sha256 460153881edcdd281e3ee4f0243d7de87272d59870e9b764b25553d6ddd4748f).
--- a/e2e/python/tests/test_process.py
+++ b/e2e/python/tests/test_process.py
@@ -35,7 +35,7 @@
     result = process(source, config)
     assert result.language == "c"  # noqa: S101
     assert len(result.structure) >= 1  # noqa: S101
-    assert any("Function" in str(_e.structure[0].kind) for _e in (result.structure or []))  # noqa: S101
+    assert any("Function" in str(_e.kind) for _e in (result.structure or []))  # noqa: S101
     assert result.metrics.total_lines >= 6  # noqa: S101
     assert result.metrics.error_count == 0  # noqa: S101

