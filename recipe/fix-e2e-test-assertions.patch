# Fix broken assertions in the auto-generated e2e test suite (upstream bug).
#
# The e2e/python/tests/*.py files are generated by the "alef" tool
# (see the "DO NOT EDIT" / "alef:hash:..." header in each file) and contain
# assertions that do not match the documented/typed return values of the
# functions under test. This causes 57 spurious test failures against a
# correctly-behaving 1.15.1 package. This patch corrects those assertions
# as evidence for an upstream bug report; it is not a functional change to
# the package itself.
#
# 1) e2e/python/tests/test_data_extraction.py (34 occurrences)
#    `assert result.data is True` is replaced with
#    `assert result.data is not None`.
#    ProcessResult.data is typed `DataNode | None`
#    (packages/python/tree_sitter_language_pack/options.py:98-130), and the
#    line immediately following each of these assertions dereferences
#    `result.data.kind`, which would raise AttributeError if `result.data`
#    were actually a bool - proving the intent was an `is not None` check.
#
# 2) e2e/python/tests/test_data_extraction.py (18 occurrences)
#    `assert <EXPR>.kind == "<LITERAL>"` is replaced with
#    `assert str(<EXPR>.kind) == "<LITERAL>"` (14x "KeyValue", 3x "Sequence",
#    1x "Element"; <EXPR> is `result.data` in every occurrence in this file).
#    DataNodeKind is a PyO3 enum (crates/ts-pack-core-py/src/lib.rs:1857-1867)
#    whose Python-visible member names are KEY_VALUE / ELEMENT / SEQUENCE -
#    NOT the PascalCase strings the tests compare against. Its __str__
#    (lib.rs:1899-1906) serde-serializes to the bare PascalCase name, and
#    upstream's own snapshot test
#    (crates/ts-pack-core/tests/snapshots/wire_format__data_node_kind_serializes_as_bare_string.snap)
#    proves DataNodeKind::KeyValue -> "KeyValue". So `str(kind) == "KeyValue"`
#    is confirmed correct by source; `.value` and `.name` do not exist on
#    this binding and would raise AttributeError. Wrapping in str() also
#    needs no new import, keeping the patch minimal - do not replace this
#    with an enum-member comparison.
#
# 3) e2e/python/tests/test_download.py (5 occurrences, in
#    test_download_clean_cache, test_download_configure_custom_dir,
#    test_download_init_default, test_prefetch_empty_list, and
#    test_prefetch_languages)
#    `assert result is not None` is replaced with `assert result is None`.
#    clean_cache(), configure(), init(), and prefetch() are all annotated
#    `-> None` in packages/python/tree_sitter_language_pack/api.py, so the
#    only correct assertion is that the call returns None.
#    NOTE: test_download_downloaded_empty (downloaded_languages() -> list[str])
#    is intentionally left untouched; its `is not None` check is correct.
--- a/e2e/python/tests/test_data_extraction.py
+++ b/e2e/python/tests/test_data_extraction.py
@@ -14,8 +14,8 @@
     config = {"data_extraction": True, "language": "caddy"}

     result = process(source, config)
-    assert result.data is True  # noqa: S101
-    assert result.data.kind == "KeyValue"  # noqa: S101
+    assert result.data is not None  # noqa: S101
+    assert str(result.data.kind) == "KeyValue"  # noqa: S101


